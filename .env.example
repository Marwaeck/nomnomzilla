# Kopieren nach .env und nach Bedarf ausfüllen. Alles ist optional.

# Host-Port, unter dem NomNomZilla erreichbar ist (http://localhost:6767)
NOMNOMZILLA_PORT=6767

# Passwortschutz im Browser (Benutzername beliebig). Leer = kein Passwort.
APP_PASSWORD=

# Schaltet den Claude-Import für fremde PDFs und Text frei. Leer = aus.
ANTHROPIC_API_KEY=
